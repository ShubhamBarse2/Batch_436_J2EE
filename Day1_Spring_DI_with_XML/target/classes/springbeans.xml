<beans>

	<bean class="com.entity.Country" id="c">
		<property name="country_Id" value="91"></property>
		<property name="c_name" value="IND"></property>
	</bean>
	<bean class="com.entity.Employee" id="emp">
		<property name="empId" value="124"></property>
		<property name="name" value="ritesh"></property>
		<property name="city" value="mumbai"></property>
		<property name="con" ref="c"></property>
	</bean>



